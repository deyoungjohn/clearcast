{
  "name": "clearcast",
  "version": "0.0.0",
  "private": true,
  "description": "Clearcast gated engineering bootstrap",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node scripts/check-bootstrap.mjs && tsc --noEmit",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "gate:status": "node scripts/gate-status.mjs",
    "gate:check": "node scripts/gate-check.mjs",
    "source:conformance": "tsx spikes/source-conformance.ts"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "lossless-json": "4.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
